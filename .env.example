# Runtime configuration for the nemohermes container.
#
#   cp .env.example .env     # then fill in the placeholders below
#   docker compose up -d
#
# Compose requires this file to exist (docker-compose.yml env_file) and injects
# it at container start, so the image itself holds no configuration and no
# secret. Changing anything here is `docker compose up -d` -- never a rebuild.
#
# Compose only checks that the file exists, not that these values are filled
# in. Leave INFERENCE_API_KEY empty and the container starts anyway, then fails
# minutes later inside onboard. The image has no fallback key.
#
# Keep .env out of git and off shared drives. This template is the shareable
# copy.
#
# MAINTAINERS: adding a variable here is not enough to make it work. systemd
# gives the bootstrap script a clean environment, so it re-imports settings
# from PID 1 through a whitelist -- see "Import configuration from PID 1" in
# the Dockerfile. A variable documented here but missing from that whitelist is
# silently ignored, and the deployment runs on the built-in default instead.

# ---- required ----
# OpenAI-compatible endpoint. Must resolve over real DNS: a proxy in fake-ip
# mode (Surge/Clash, 198.18.x.x) makes the onboard probe fail. Do not point
# this at https://inference.local/v1 -- that name exists only in the sandbox.
INFERENCE_BASE_URL=https://YOUR_INFERENCE_HOST/v1

# Model the gateway sends to that endpoint. Note this is NOT the model name you
# send to the Hermes API -- there you always use `hermes-agent`.
INFERENCE_MODEL=YOUR_MODEL_NAME

# Your provider key. Never baked into the image.
INFERENCE_API_KEY=YOUR_INFERENCE_API_KEY

# Sandbox onboard creates: 1-19 chars, lowercase letters/digits/single hyphens,
# must start with a letter.
SANDBOX_NAME=main

# ---- optional ----
# off | smart | manual. Empty skips the approvals step entirely.
APPROVALS_MODE=manual

# Gateway-managed MCP router. Must be public HTTPS. Leave MCP_URL empty to skip
# MCP; when it is set, MCP_ROUTER_TOKEN is required. Registration failure is
# never fatal -- it must not take the Hermes API down with it.
MCP_URL=
MCP_ROUTER_TOKEN=
# Name of the OpenShell credential the sandbox resolves, not the token itself.
# MCP_ENV_VAR=MCP_ROUTER_TOKEN

# ---- rarely changed ----
# Host-side ports. Compose publishes each on the same number inside and out, so
# changing one here moves both ends.
# HERMES_API_PORT=8642
# HERMES_DASHBOARD_PORT=18789

# Address the in-container forwards bind. docker-compose.yml already sets
# 0.0.0.0 so published ports work; to restrict access to this machine, change
# the compose `ports` bind to 127.0.0.1:8642:8642 instead of editing this.
# FORWARD_BIND=0.0.0.0

# Agent runtime. Keep as is.
# AGENT=hermes

# Extra sandbox images to pull if missing (space-separated).
# SANDBOX_PULL_IMAGES=

# Force GPU passthrough on or off. Unset is correct: the entrypoint decides
# from nvidia-smi, because the Docker GPU patch runs even when preflight
# reports no GPU and then fails the sandbox create. An explicit value wins.
# NEMOCLAW_SANDBOX_GPU=0

# Discard the onboard session on the next start. May re-resolve the sandbox
# base image, so expect a long first run.
# ONBOARD_FRESH=0

# Entrypoint timeouts in seconds. Raise these on a slow disk or link.
# DOCKER_WAIT_SECS=90
# USER_MANAGER_WAIT_SECS=90
# SANDBOX_WAIT_SECS=180
# SANDBOX_READY_GRACE_SECS=8
